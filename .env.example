# Copy to .env (chmod 600) and fill in. Never commit the real .env.

# Anthropic API key used by jarvis-server's agent core.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Bearer token for the admin user referenced from config/users.yaml.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JARVIS_ADMIN_TOKEN=change-me-generate-a-long-random-token
